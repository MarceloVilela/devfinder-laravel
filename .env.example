APP_NAME=DevFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=devfinder
DB_USERNAME=devfinder
DB_PASSWORD=devfinder
DB_SSLMODE=prefer

CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Autenticação (Fase 4). Sessão por cookie `devfinder_token` (httpOnly); em produção o login e o callback passam pelo proxy /backend do front. JWT_SECRET: no mínimo 32 bytes (`openssl rand -hex 32`). Em produção vêm do SSM.
JWT_SECRET=
APP_WEB_URL=http://localhost:3000
# OAuth App do GitHub (github.com/settings/developers); callback = http://localhost:8082/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8082/v1/auth/github/callback
CACHE_LIMITER_STORE=database

# Ingestão agendada (Fase 6): `php artisan video:refresh` busca os candidatos neste bin do JSONBin. Vazios = o comando avisa e não faz nada.
# Em produção vêm do SSM (jsonbin-api-key, jsonbin-id-subs), só na função `refresh`. Sem o bin: `php artisan video:refresh --fixture=tests/Fixtures/jsonbin-videos.json`.
JSONBIN_API_KEY=
JSONBIN_ID_SUBS=
